{
  "name": "campusos",
  "version": "0.1.0",
  "private": true,
  "description": "CampusOS — multi-tenant education operations platform (working codename).",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" --if-present run build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./packages/**\" --filter @repo/api --filter @repo/web --if-present run dev",
    "dev:worker": "pnpm --filter @repo/api run dev:worker",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --parallel --filter @repo/api --filter @repo/web run start",
    "lint": "pnpm build:packages && pnpm -r --if-present run lint",
    "typecheck": "pnpm build:packages && pnpm -r --if-present run typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @repo/web run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "pnpm build:packages && pnpm --filter @repo/api run db:migrate",
    "db:seed": "pnpm build:packages && pnpm --filter @repo/api run db:seed",
    "db:reset": "pnpm build:packages && pnpm --filter @repo/api run db:reset",
    "db:generate": "pnpm build:packages && pnpm --filter @repo/api run db:generate"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
