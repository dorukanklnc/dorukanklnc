# ─────────────────────────────────────────────────────────────────────────────
# CampusOS local development environment. Copy to `.env` (never commit `.env`).
# Values below match infra/docker/docker-compose.yml and are for development only.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
LOG_LEVEL=info
LOG_PRETTY=true
# Trust exactly one proxy hop for the client address (the Next.js server in development, the
# load balancer in production). Must match the real proxy chain; see docs/architecture/SECURITY.md.
TRUST_PROXY=true

# Three database roles (see docs/architecture/MULTITENANCY.md):
#   app_runtime → request handling (RLS enforced) · app_system → workers/platform/pre-auth
#   app_owner   → migrations only
DATABASE_URL=postgres://app_runtime:app_runtime_dev@localhost:5432/campusos
DATABASE_SYSTEM_URL=postgres://app_system:app_system_dev@localhost:5432/campusos
DATABASE_MIGRATION_URL=postgres://app_owner:app_owner_dev@localhost:5432/campusos
# Superuser connection used only by `pnpm db:reset` and the integration test setup.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

REDIS_URL=redis://localhost:6379
RATE_LIMIT_STORE=memory

# Field-level encryption for national ID numbers (AES-256-GCM, base64 32-byte key) and the
# HMAC key for exact-match lookups. Generate production values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktZmllbGQtZW5jcnlwdGlvbi1rZXktMzI=
FIELD_HASH_KEY=dev-only-field-hash-key-change-me-0123456789

# Mail: console (written to the API log; works without any mail server) | smtp (Mailpit from
# `pnpm infra:up`, inbox at http://localhost:8025) | memory (tests)
MAIL_DRIVER=console
MAIL_FROM="CampusOS <no-reply@campusos.local>"
SMTP_HOST=localhost
SMTP_PORT=1025

# Mock payment provider webhook signing secret (development only)
PAYMENT_MOCK_WEBHOOK_SECRET=dev-only-mock-webhook-secret

# Web app → API proxy target (used by apps/web next.config.ts)
API_INTERNAL_URL=http://localhost:4000
