{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CampusOS API \u2014 NestJS modular monolith and background worker.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --enable-source-maps dist/main.js\"",
    "dev:worker": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --enable-source-maps dist/worker.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/database/scripts/migrate.ts",
    "db:seed": "tsx src/platform/database/scripts/seed.ts",
    "db:reset": "tsx src/platform/database/scripts/reset.ts",
    "openapi": "tsx src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@opentelemetry/api": "1.9.1",
    "@repo/authorization": "workspace:*",
    "@repo/contracts": "workspace:*",
    "bullmq": "6.3.11",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsc-watch": "7.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
